<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 3:4 portrait viewfinder -->
    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/flash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- Controls, pinned to the bottom -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/btnLevel" style="@style/CtrlButton"
                android:layout_marginHorizontal="4dp" android:minWidth="0dp" android:text="LEVEL ○" />
            <TextView android:id="@+id/btnRotate" style="@style/CtrlButton"
                android:layout_marginHorizontal="4dp" android:minWidth="0dp" android:text="ROTATE" />
            <TextView android:id="@+id/btnDate" style="@style/CtrlButton"
                android:layout_marginHorizontal="4dp" android:minWidth="0dp" android:text="DATE ●" />
            <TextView android:id="@+id/btnTrack" style="@style/CtrlButton"
                android:layout_marginHorizontal="4dp" android:minWidth="0dp" android:text="TRACK" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/btnMode" style="@style/CtrlButton"
                    android:layout_gravity="center" android:text="VIDEO" />
            </FrameLayout>

            <View
                android:id="@+id/btnShutter"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/shutter_rec"
                android:contentDescription="Shutter" />

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <TextView android:id="@+id/btnFlip" style="@style/CtrlButton"
                    android:layout_gravity="center" android:text="FLIP" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ctrl_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="FX"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/fxSeek"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="#E53935"
                android:thumbTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
